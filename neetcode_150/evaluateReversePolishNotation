import re

def evalRPN(self, tokens: list[str]) -> int:
    stack = []
    for token in tokens:
        if token.lstrip('-').isdigit():
            stack.append(int(token))
        elif token == "+":
            a = stack.pop()
            b = stack.pop()
            stack.append(a+b)
        elif token == "-":
            a = stack.pop()
            b = stack.pop()
            stack.append(b-a)
        elif token == "*":
            a = stack.pop()
            b = stack.pop()
            stack.append(a*b)
        elif token == "/":
            a = stack.pop()
            b = stack.pop()
            stack.append(int(b/a))
    return stack[0]




