class ListNode:
    def __init__(self, val=0, next=None):
        self.val = val
        self.next = next
    def mergeTwoLists(self, list1: ListNode | None, list2: ListNode | None) -> ListNode | None:
        l3 = ListNode()
        head = l3
        while list1 is not None and list2 is not None:
            if list1.val > list2.val:
                l3.val = list2.val

                list2 = list2.next
            else:
                l3.val = list1.val
                list1 = list1.next
            l3.next = ListNode()
            l3 = l3.next
        while list1 is not None:
            l3.val = list1.val
            l3.next = ListNode()
            l3 = l3.next
            list1 = list1.next
        while list2 is not None:
            l3.val = list2.val
            l3.next = ListNode()
            l3 = l3.next
            list2 = list2.next
        return head