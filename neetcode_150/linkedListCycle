from typing import Optional
class ListNode:
    def __init__(self, val=0, next=None):
        self.val = val
        self.next = next

def hasCycle(self, head: Optional[ListNode]) -> bool:
    if head is None or head.next is None:
        return False
    slow = head
    fast = head.next
    while fast.next is not None and fast.next.next is not None:
        if slow == fast:
            return True
        fast = fast.next.next
        slow = slow.next
    return False    

